# Leave empty for isolated, fictional demo. DEMO_MODE must be false for real data.
DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server / bootstrap only. Never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
BOOTSTRAP_ADMIN_EMAIL=
# Original rate CSV has no effective dates. An admin must explicitly confirm this.
RATE_EFFECTIVE_FROM=
PRIVATE_IMPORT_ORG_ID=
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes encoded as base64, required for Google token encryption.
TOKEN_ENCRYPTION_KEY=

# GitHub Pages build: public values only. Never prefix any secret with VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# AQR_APP_URL is a Supabase Edge Function secret/config value, not a browser key.
# Set it to the exact deployed Pages URL (including repository path and trailing /).
